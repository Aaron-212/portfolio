---
const links = [
  {
    label: "Home",
    href: "/",
    links: [{ label: "About", href: "/about" }]
  },
  {
    label: "Projects",
    href: "/projects",
    links: [{ label: "McSrvrS", href: "#" }]
  },
  {
    label: "Blog",
    href: "/blog",
    links: [{ label: "Hello", href: "#" }]
  },
  {
    label: "Docs",
    href: "/docs",
    links: [{ label: "Hello", href: "#" }]
  },
  {
    label: "Other Links",
    href: "#",
    links: [{ label: "CNBlogs", href: "https://www.cnblogs.com/Aaron212" }]
  }
];
---

<header
  data-site-header
  class="pointer-events-none fixed top-0 z-50 h-dvh w-dvw bg-neutral-50/0 backdrop-blur-none transition-all duration-250 ease-in-out select-none md:delay-250 dark:bg-neutral-900/0"
>
  <nav
    data-navigation
    aria-label="Main navigation"
    class="pointer-events-auto flex h-12 w-full flex-col items-center overflow-clip bg-neutral-50/80 backdrop-blur-xl transition-all duration-250 ease-in-out md:delay-250 dark:bg-neutral-900/80"
  >
    <div
      class="flex h-12 w-full flex-shrink-0 flex-row flex-nowrap items-center gap-6 px-6 transition-none md:w-3/4 md:px-0"
    >
      <a class="text-lg font-bold text-black dark:text-white" href="/">Aaron212</a>
      <div class="hidden flex-row items-center gap-4 lg:flex">
        {
          links.slice(0, -1).map((link) => (
            <a class="text-black dark:text-white" href={link.href} data-section-link={link.label}>
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="flex-grow"><!-- Spacer --></div>
      <a href="https://x.com/AR___212" aria-label="Aaron212 on X">
        <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817-5.967 6.817H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
          ></path>
        </svg>
      </a>
      <a href="https://github.com/Aaron-212" aria-label="Aaron212 on GitHub">
        <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.74-1.55-2.57-.3-5.28-1.29-5.28-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.98 10.98 0 0 1 5.75 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
          ></path>
        </svg>
      </a>
      <button
        data-menu-toggle
        class="md:hidden"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg aria-hidden="true" class="size-4" viewBox="0 0 448 512" fill="currentColor">
          <path
            d="M0 96c0-17.7 14.3-32 32-32h384a32 32 0 1 1 0 64H32C14.3 128 0 113.7 0 96Zm0 160c0-17.7 14.3-32 32-32h384a32 32 0 1 1 0 64H32c-17.7 0-32-14.3-32-32Zm448 160c0 17.7-14.3 32-32 32H32a32 32 0 1 1 0-64h384c17.7 0 32 14.3 32 32Z"
          ></path>
        </svg>
      </button>
    </div>

    <div
      data-menu-content
      class="flex w-full justify-center opacity-0 transition-[opacity] duration-250 ease-in-out md:delay-250"
    >
      <!-- Desktop -->
      <div class="mt-8 hidden w-3/4 flex-shrink-0 overflow-hidden lg:grid lg:items-start">
        {
          links.slice(0, -1).map((link, index) => (
            <div
              data-section-panel={link.label}
              class="col-start-1 row-start-1 flex min-w-40 flex-col gap-2 justify-self-start"
              hidden={index !== 0}
            >
              <p class="text-sm text-slate-700 dark:text-slate-300">{link.label}</p>
              {link.links.map((sublink) => (
                <a
                  class="text-2xl font-extrabold text-slate-800 transition-all duration-200 ease-in-out hover:text-black dark:text-slate-200 dark:hover:text-white"
                  href={sublink.href}
                >
                  {sublink.label}
                </a>
              ))}
            </div>
          ))
        }
        {
          links.slice(-1).map((link) => (
            <div class="col-start-1 row-start-1 flex min-w-40 flex-col items-end gap-2 justify-self-end">
              <p class="text-sm text-slate-700 dark:text-slate-300">{link.label}</p>
              {link.links.map((sublink) => (
                <a
                  class="text-2xl font-extrabold text-slate-800 transition-all duration-200 ease-in-out hover:text-black dark:text-slate-200 dark:hover:text-white"
                  href={sublink.href}
                >
                  {sublink.label}
                </a>
              ))}
            </div>
          ))
        }
      </div>

      <!-- Mobile -->
      <div class="mt-8 flex w-full flex-shrink-0 flex-col gap-2 overflow-hidden px-5 lg:hidden">
        {
          links.flatMap((link) =>
            link.links.map((sublink) => (
              <a
                class="text-2xl font-extrabold text-slate-800 transition-all duration-200 ease-in-out hover:text-black dark:text-slate-200 dark:hover:text-white"
                href={sublink.href}
              >
                {sublink.label}
              </a>
            ))
          )
        }
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const navigation = header?.querySelector<HTMLElement>("[data-navigation]");
  const content = header?.querySelector<HTMLElement>("[data-menu-content]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)");

  function setOpen(isOpen: boolean) {
    if (!header || !navigation || !content || !toggle) return;

    header.classList.toggle("bg-neutral-50/25", isOpen);
    header.classList.toggle("backdrop-blur-xl", isOpen);
    header.classList.toggle("dark:bg-neutral-900/25", isOpen);
    navigation.classList.toggle("h-[75vh]", isOpen);
    navigation.classList.toggle("md:h-80", isOpen);
    navigation.classList.toggle("backdrop-blur-none", isOpen);
    content.classList.toggle("opacity-100", isOpen);
    content.classList.toggle("opacity-0", !isOpen);
    toggle.setAttribute("aria-expanded", String(isOpen));
  }

  navigation?.addEventListener("mouseenter", () => {
    if (canHover.matches) setOpen(true);
  });
  navigation?.addEventListener("mouseleave", () => {
    if (canHover.matches) setOpen(false);
  });
  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  header?.querySelectorAll<HTMLElement>("[data-section-link]").forEach((link) => {
    link.addEventListener("mouseenter", () => {
      const section = link.dataset.sectionLink;

      header.querySelectorAll<HTMLElement>("[data-section-panel]").forEach((panel) => {
        const isActive = panel.dataset.sectionPanel === section;
        panel.hidden = !isActive;

        if (isActive && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          panel.animate(
            [
              { opacity: 0, transform: "translateX(100px)" },
              { opacity: 1, transform: "translateX(0)" }
            ],
            { duration: 200, easing: "ease-out" }
          );
        }
      });
    });
  });
</script>
