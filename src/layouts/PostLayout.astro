---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { MarkdownHeading } from "astro";

interface Props {
  title: string;
  excerpt?: string;
  headings?: MarkdownHeading[];
}

const { title, excerpt, headings = [] } = Astro.props;
const tableOfContents = headings.filter(({ depth }) => depth >= 2 && depth <= 3);
---

<BaseLayout title={`${title}`} description={excerpt}>
  <div class="mx-4 my-4 flex flex-col-reverse gap-8 lg:flex-row lg:items-start lg:justify-center">
    <article class="lg:prose-l prose min-w-0 select-auto dark:prose-invert">
      <h1>{title}</h1>
      <slot />
    </article>
    {tableOfContents.length > 0 && (
      <>
        <details class="not-prose p-5 lg:hidden">
          <summary class="cursor-pointer text-sm font-semibold uppercase">On this page</summary>
          <nav aria-label="Table of contents" class="mt-3">
            <ol class="space-y-2 border-l border-blue-light/60 text-sm dark:border-blue-dark/60">
              {tableOfContents.map(({ depth, slug, text }) => (
                <li class={`text-black/60 dark:text-white/60 ${depth === 3 ? "ps-8" : "ps-4"}`}>
                  <a class="block text-inherit" href={`#${slug}`}>{text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
        <nav
          aria-label="Table of contents"
          data-table-of-contents
          class="not-prose hidden p-5 lg:sticky lg:top-24 lg:block lg:max-h-[calc(100dvh-6rem)] lg:w-64 lg:flex-none lg:self-start lg:overflow-y-auto"
        >
          <p class="mb-3 text-sm font-semibold uppercase">On this page</p>
          <ol class="space-y-2 border-l border-blue-light/60 text-sm dark:border-blue-dark/60">
            {tableOfContents.map(({ depth, slug, text }) => (
              <li
                class={`group border-s-0 text-black/60 transition-all aria-[current=location]:border-s-2 aria-[current=location]:text-blue-light dark:text-white/60 dark:aria-[current=location]:text-blue-dark ${
                  depth === 3 ? "ps-8" : "ps-4"
                }`}
                data-toc-item
              >
                <a class="block text-inherit group-aria-[current=location]:font-semibold" href={`#${slug}`}>
                  {text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </>
    )}
  </div>

  <script>
  let cleanupCurrentPage: (() => void) | undefined;

  function setupCurrentPage() {
    cleanupCurrentPage?.();

    const items = Array.from(
      document.querySelectorAll<HTMLElement>("[data-table-of-contents] [data-toc-item]")
    );
    const entries = items.flatMap((item) => {
      const link = item.querySelector<HTMLAnchorElement>("a[href^='#']");
      const id = link?.getAttribute("href")?.slice(1);
      const heading = id ? document.getElementById(id) : null;

      return heading ? [{ heading, item }] : [];
    });

    if (entries.length === 0) {
      cleanupCurrentPage = undefined;
      return;
    }

    const controller = new AbortController();
    let animationFrame: number | undefined;

    function updateCurrentHeading() {
      animationFrame = undefined;

      const readingLine = 112;
      let currentHeading = entries[0].heading;

      for (const entry of entries) {
        if (entry.heading.getBoundingClientRect().top > readingLine) break;
        currentHeading = entry.heading;
      }

      for (const entry of entries) {
        if (entry.heading === currentHeading) {
          entry.item.setAttribute("aria-current", "location");
        } else {
          entry.item.removeAttribute("aria-current");
        }
      }
    }

    function scheduleUpdate() {
      if (animationFrame !== undefined) return;
      animationFrame = requestAnimationFrame(updateCurrentHeading);
    }

    cleanupCurrentPage = () => {
      controller.abort();
      if (animationFrame !== undefined) cancelAnimationFrame(animationFrame);
      cleanupCurrentPage = undefined;
    };

    updateCurrentHeading();
    window.addEventListener("scroll", scheduleUpdate, { passive: true, signal: controller.signal });
    window.addEventListener("resize", scheduleUpdate, { signal: controller.signal });
  }

  setupCurrentPage();
  document.addEventListener("astro:page-load", setupCurrentPage);
  document.addEventListener("astro:before-swap", () => cleanupCurrentPage?.());
  </script>
</BaseLayout>
