---
const links = [
  {
    label: "Home",
    href: "/",
    links: [{ label: "About", href: "/about" }]
  },
  {
    label: "Projects",
    href: "/projects",
    links: [{ label: "McSrvrS", href: "/projects/mcsrvrs" }]
  },
  {
    label: "Blog",
    href: "/blog",
    links: [{ label: "Hello", href: "#" }]
  },
  {
    label: "Docs",
    href: "/docs",
    links: [{ label: "Hello", href: "#" }]
  },
  {
    label: "Other Links",
    href: "#",
    links: [{ label: "CNBlogs", href: "https://www.cnblogs.com/Aaron212" }]
  }
];

import { Icon } from "astro-icon/components";
---

<header
  data-site-header
  class="pointer-events-none fixed top-0 z-50 h-dvh w-dvw bg-neutral-50/0 backdrop-blur-none transition-all duration-250 ease-in-out select-none motion-reduce:transition-none lg:delay-250 dark:bg-neutral-900/0"
>
  <nav
    data-navigation
    aria-label="Main navigation"
    class="pointer-events-auto relative flex h-12 w-full flex-col items-center overflow-clip bg-neutral-50/80 backdrop-blur-xl transition-all duration-250 ease-in-out motion-reduce:transition-none lg:delay-250 dark:bg-neutral-900/80"
  >
    <div class="flex h-12 w-full shrink-0 items-center gap-4 px-6 md:w-3/4 md:px-0">
      <span class="text-lg font-bold text-black select-none dark:text-white">Aaron212</span>

      <div data-desktop-sections class="hidden items-center lg:flex">
        {
          links.slice(0, -1).map((link) => (
            <div data-section-group class="flex h-12 items-center px-2">
              <a class="text-black dark:text-white" href={link.href}>
                {link.label}
              </a>
              <div
                data-section-panel
                class="pointer-events-none absolute top-10 left-1/2 z-10 flex w-3/4 -translate-x-1/2 flex-col gap-2 pt-10 opacity-0 transition-opacity duration-200 ease-in-out motion-reduce:transition-none"
              >
                <p class="text-sm text-neutral-700 dark:text-neutral-300">{link.label}</p>
                {link.links.map((sublink) => (
                  <a
                    class="w-fit text-2xl font-bold text-black transition-colors duration-200 ease-in-out dark:text-white"
                    href={sublink.href}
                  >
                    {sublink.label}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="grow"><!-- Spacer --></div>
      <a href="https://x.com/AR___212" aria-label="Aaron212 on X">
        <Icon name="simple-icons:x" class="max-h-5" />
      </a>
      <a href="https://github.com/Aaron-212" aria-label="Aaron212 on GitHub">
        <Icon name="simple-icons:github" class="max-h-5" />
      </a>

      <details data-mobile-menu class="lg:hidden">
        <summary class="cursor-pointer list-none" aria-label="Toggle navigation menu">
          <Icon name="lucide:menu" />
        </summary>
        <div class="absolute top-12 left-0 flex w-full flex-col gap-2 px-5 pt-8">
          {
            links.flatMap((link) =>
              link.links.map((sublink) => (
                <a
                  class="text-2xl font-bold text-black transition-colors duration-200 ease-in-out dark:text-white"
                  href={sublink.href}
                >
                  {sublink.label}
                </a>
              ))
            )
          }
        </div>
      </details>
    </div>

    {
      links.slice(-1).map((link) => (
        <div
          data-desktop-menu
          class="pointer-events-none absolute top-10 right-[12.5%] z-10 hidden flex-col items-end gap-2 pt-10 opacity-0 transition-opacity duration-200 ease-in-out motion-reduce:transition-none lg:flex"
        >
          <p class="text-sm text-neutral-700 dark:text-neutral-300">{link.label}</p>
          {link.links.map((sublink) => (
            <a
              class="text-2xl font-bold text-black transition-colors duration-200 ease-in-out dark:text-white"
              href={sublink.href}
            >
              {sublink.label}
            </a>
          ))}
        </div>
      ))
    }
  </nav>
</header>

<style>
  [data-mobile-menu] summary::-webkit-details-marker {
    display: none;
  }

  @media (max-width: 63.999rem) {
    [data-navigation]:has([data-mobile-menu][open]) {
      height: 75vh;
      backdrop-filter: none;
    }

    [data-site-header]:has([data-mobile-menu][open]) {
      background-color: rgb(250 250 250 / 0.25);
      backdrop-filter: blur(24px);
    }
  }

  @media (min-width: 64rem) {
    [data-navigation]:is(:has([data-section-group]:focus-within), :has([data-desktop-menu]:focus-within)) {
      height: 20rem;
      backdrop-filter: none;
    }

    [data-site-header]:has(
      [data-navigation]:is(:has([data-section-group]:focus-within), :has([data-desktop-menu]:focus-within))
    ) {
      background-color: rgb(250 250 250 / 0.25);
      backdrop-filter: blur(24px);
    }

    [data-section-group]:focus-within [data-section-panel],
    [data-desktop-menu]:focus-within {
      pointer-events: auto;
      opacity: 1;
    }
  }

  @media (min-width: 64rem) and (hover: hover) and (pointer: fine) {
    [data-section-group]:hover::after {
      position: absolute;
      inset: 3rem 0 0;
      z-index: 0;
      content: "";
    }

    [data-navigation]:hover {
      height: 20rem;
      backdrop-filter: none;
    }

    [data-site-header]:has([data-navigation]:hover) {
      background-color: rgb(250 250 250 / 0.25);
      backdrop-filter: blur(24px);
    }

    [data-navigation]:hover [data-desktop-menu],
    [data-navigation]:hover
      [data-desktop-sections]:not(:has([data-section-group]:is(:hover, :focus-within)))
      [data-section-group]:first-child
      [data-section-panel],
    [data-navigation]:hover [data-section-group]:is(:hover, :focus-within) [data-section-panel] {
      pointer-events: auto;
      opacity: 1;
    }
  }

  @media (max-width: 63.999rem) and (prefers-color-scheme: dark) {
    [data-site-header]:has([data-mobile-menu][open]) {
      background-color: rgb(23 23 23 / 0.25);
    }
  }

  @media (min-width: 64rem) and (prefers-color-scheme: dark) {
    [data-site-header]:has(
      [data-navigation]:is(:has([data-section-group]:focus-within), :has([data-desktop-menu]:focus-within))
    ) {
      background-color: rgb(23 23 23 / 0.25);
    }
  }

  @media (min-width: 64rem) and (hover: hover) and (pointer: fine) and (prefers-color-scheme: dark) {
    [data-site-header]:has([data-navigation]:hover) {
      background-color: rgb(23 23 23 / 0.25);
    }
  }
</style>
