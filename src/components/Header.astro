---
const links = [
  {
    label: "Home",
    href: "/",
    links: [
      { label: "Home", href: "/" },
      { label: "About", href: "/about" },
      { label: "Partner Links", href: "/partner-links" }
    ]
  },
  {
    label: "Projects",
    href: "/projects",
    links: [
      { label: "McSrvrS", href: "/projects/mcsrvrs" },
      { label: "FnPilot", href: "/projects/fnpilot" },
      { label: "NBTPlus", href: "/projects/nbtplus" }
    ]
  },
  {
    label: "Blog",
    href: "/blog",
    links: [{ label: "Hello", href: "#" }]
  },
  {
    label: "Docs",
    href: "/docs",
    links: [{ label: "Hello", href: "#" }]
  }
];

const rightLinks = {
  label: "Other Links",
  links: [{ label: "CNBlogs", href: "https://www.cnblogs.com/Aaron212" }]
};

import { Icon } from "astro-icon/components";
---

<header data-site-header class="pointer-events-none sticky top-0 z-50 h-12 select-none">
  <nav
    data-navigation
    aria-label="Main navigation"
    class="pointer-events-auto relative flex h-12 w-full flex-col items-center overflow-clip bg-slate-50/80 backdrop-blur-xl transition-all duration-250 ease-in-out motion-reduce:transition-none lg:delay-250 dark:bg-slate-950/80"
  >
    <div class="mx-auto flex h-12 w-full max-w-4xl shrink-0 items-center gap-4 px-6">
      <span class="select-none text-lg font-bold text-black dark:text-white">Aaron212</span>

      <div data-desktop-sections class="hidden items-center lg:flex">
        {links.map((link) => (
          <div data-section-group class="flex h-12 items-center px-2">
            <a
              class="text-black transition-colors hover:text-blue-light focus-visible:text-blue-light dark:text-white dark:hover:text-blue-dark dark:focus-visible:text-blue-dark"
              href={link.href}
            >
              {link.label}
            </a>
            <div
              data-section-panel
              class="pointer-events-none absolute top-10 left-1/2 z-10 flex w-full max-w-4xl -translate-x-1/2 flex-col gap-2 px-6 pt-10 opacity-0 transition-opacity duration-200 ease-in-out motion-reduce:transition-none"
            >
              <p class="text-sm text-slate-700 dark:text-slate-300">{link.label}</p>
              {link.links.map((sublink) => (
                <a
                  class="w-fit text-2xl font-bold text-black transition-colors duration-200 ease-in-out hover:text-blue-light focus-visible:text-blue-light dark:text-white dark:hover:text-blue-dark dark:focus-visible:text-blue-dark"
                  href={sublink.href}
                >
                  {sublink.label}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="grow"><!-- Spacer --></div>

      <div class="flex items-center gap-4 lg:gap-6">
        <a href="https://x.com/AR___212" aria-label="Aaron212 on X">
          <Icon name="fa7-brands:x-twitter" class="size-4" />
        </a>
        <a href="https://github.com/Aaron-212" aria-label="Aaron212 on GitHub">
          <Icon name="fa7-brands:github" class="size-4" />
        </a>

        <details data-mobile-menu class="lg:hidden">
          <summary class="cursor-pointer list-none" aria-label="Toggle navigation menu">
            <Icon name="fa7-solid:bars" class="size-4" />
          </summary>
          <div class="absolute top-12 left-1/2 flex w-full max-w-4xl -translate-x-1/2 flex-col gap-2 px-6 pt-8">
            {[...links, rightLinks].flatMap((link) => link.links.map((sublink) => (
              <a
                class="text-2xl font-bold text-black transition-colors duration-200 ease-in-out hover:text-blue-light focus-visible:text-blue-light dark:text-white dark:hover:text-blue-dark dark:focus-visible:text-blue-dark"
                href={sublink.href}
              >
                {sublink.label}
              </a>
            )))}
          </div>
        </details>
      </div>
    </div>

    <div
      data-desktop-menu
      class="pointer-events-none absolute top-10 right-[max(1.5rem,calc((100%-56rem)/2+1.5rem))] z-10 hidden flex-col items-end gap-2 pt-10 opacity-0 transition-opacity duration-200 ease-in-out motion-reduce:transition-none lg:flex"
    >
      <p class="text-sm text-slate-700 dark:text-slate-300">{rightLinks.label}</p>
      {rightLinks.links.map((link) => (
        <a
          class="text-2xl font-bold text-black transition-colors duration-200 ease-in-out hover:text-blue-light focus-visible:text-blue-light dark:text-white dark:hover:text-blue-dark dark:focus-visible:text-blue-dark"
          href={link.href}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
[data-site-header]::before {
  position: fixed;
  inset: 0;
  z-index: -1;
  background-color: transparent;
  backdrop-filter: none;
  transition: background-color 250ms ease-in-out, backdrop-filter 250ms ease-in-out;
  content: "";
}

[data-mobile-menu] summary::-webkit-details-marker {
  display: none;
}

@media (max-width: 63.999rem), (any-pointer: coarse) {
  [data-navigation]:has([data-mobile-menu][open]) {
    height: 75dvh;
    backdrop-filter: none;
  }

  [data-site-header]:has([data-mobile-menu][open])::before {
    background-color: rgb(250 250 250 / 0.25);
    backdrop-filter: blur(24px);
  }
}

@media (min-width: 64rem) {
  [data-site-header]::before {
    transition-delay: 250ms;
  }

  [data-navigation]:is(:has([data-section-group]:focus-within), :has([data-desktop-menu]:focus-within)) {
    height: 20rem;
    backdrop-filter: none;
  }

  [data-site-header]:has([data-navigation]:is(:has([data-section-group]:focus-within), :has([data-desktop-menu]:focus-within)))::before {
    background-color: rgb(250 250 250 / 0.25);
    backdrop-filter: blur(24px);
  }

  [data-section-group]:focus-within [data-section-panel],
  [data-desktop-menu]:focus-within {
    pointer-events: auto;
    opacity: 1;
  }
}

@media (min-width: 64rem) and (hover: hover) and (pointer: fine) {
  [data-section-group]:hover::after {
    position: absolute;
    inset: 3rem 0 0;
    z-index: 0;
    content: "";
  }

  [data-navigation]:hover {
    height: 20rem;
    backdrop-filter: none;
  }

  [data-site-header]:has([data-navigation]:hover)::before {
    background-color: rgb(250 250 250 / 0.25);
    backdrop-filter: blur(24px);
  }

  [data-navigation]:hover [data-desktop-menu],
  [data-navigation]:hover
    [data-desktop-sections]:not(:has([data-section-group]:is(:hover, :focus-within)))
    [data-section-group]:first-child
    [data-section-panel],
  [data-navigation]:hover [data-section-group]:is(:hover, :focus-within) [data-section-panel] {
    pointer-events: auto;
    opacity: 1;
  }
}

@media (any-pointer: coarse) {
  [data-desktop-sections],
  [data-desktop-menu] {
    display: none;
  }

  [data-mobile-menu] {
    display: block;
  }
}

@media (max-width: 63.999rem) and (prefers-color-scheme: dark), (any-pointer: coarse) and (prefers-color-scheme: dark) {
  [data-site-header]:has([data-mobile-menu][open])::before {
    background-color: rgb(23 23 23 / 0.25);
  }
}

@media (min-width: 64rem) and (prefers-color-scheme: dark) {
  [data-site-header]:has([data-navigation]:is(:has([data-section-group]:focus-within), :has([data-desktop-menu]:focus-within)))::before {
    background-color: rgb(23 23 23 / 0.25);
  }
}

@media (min-width: 64rem) and (hover: hover) and (pointer: fine) and (prefers-color-scheme: dark) {
  [data-site-header]:has([data-navigation]:hover)::before {
    background-color: rgb(23 23 23 / 0.25);
  }
}

@media (prefers-reduced-motion: reduce) {
  [data-site-header]::before {
    transition: none;
  }
}
</style>
