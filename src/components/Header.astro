---
type Link = {
  label: string;
  href: string;
};

type Sublink = Link & {
  showOnMobile?: boolean;
};

type LinkGroup = Link & {
  links: Sublink[];
};

import { m } from "@/paraglide/messages.js";
import { localizeHref } from "@/paraglide/runtime.js";

const links: LinkGroup[] = [
  {
    label: m.navHome(),
    href: localizeHref("/"),
    links: [{ label: m.navAbout(), href: localizeHref("/about"), showOnMobile: true }]
  },
  {
    label: m.navProjects(),
    href: localizeHref("/projects"),
    links: [
      { label: "McSrvrS", href: localizeHref("/projects/mcsrvrs") },
      { label: "FnPilot", href: localizeHref("/projects/fnpilot") },
      { label: "NBTPlus", href: localizeHref("/projects/nbtplus") }
    ]
  },
  {
    label: m.navBlog(),
    href: localizeHref("/blog"),
    links: [{ label: m.navHello(), href: "#" }]
  },
  {
    label: m.navDocs(),
    href: localizeHref("/docs"),
    links: [{ label: m.navHello(), href: "#" }]
  }
];

const rightLinks = {
  label: m.navOtherLinks(),
  links: [
    {
      label: m.navPartnerLinks(),
      href: localizeHref("/partner-links"),
      showOnMobile: true
    }
  ] satisfies Sublink[]
};

const mobileLinks = [
  ...links.flatMap(({ label, href, links }) => [{ label, href }, ...links.filter(({ showOnMobile }) => showOnMobile)]),
  ...rightLinks.links.filter(({ showOnMobile }) => showOnMobile)
];

import { Icon } from "astro-icon/components";
---

<header data-site-header class="pointer-events-none sticky top-0 z-50 h-12 select-none">
  <nav
    data-navigation
    aria-label={m.ariaMainNavigation()}
    class="pointer-events-auto relative flex h-12 w-full flex-col items-center overflow-clip bg-slate-50/80 backdrop-blur-xl transition-all duration-250 ease-in-out motion-reduce:transition-none lg:delay-250 dark:bg-slate-950/80"
  >
    <div class="mx-auto flex h-12 w-full max-w-4xl shrink-0 items-center gap-4 px-6">
      <span class="select-none text-lg font-bold text-black dark:text-white">Aaron212</span>

      <div data-desktop-sections class="hidden items-center lg:flex ps-2">
        {links.map((link, index) => (
          <div data-section-group class="group flex h-12 items-center ps-2">
            <a
              class="text-black transition-colors hover:text-blue-light focus-visible:text-blue-light dark:text-white dark:hover:text-blue-dark dark:focus-visible:text-blue-dark"
              href={link.href}
            >
              {link.label}
            </a>
            <button
              type="button"
              data-section-trigger
              aria-label={m.ariaSectionMenu({ section: link.label })}
              aria-expanded="false"
              aria-controls={`site-submenu-${index}`}
              class="flex min-h-11 min-w-6 shrink-0 cursor-pointer items-center justify-center rounded opacity-0 transition group-hover:opacity-100 group-focus-within:opacity-100 aria-expanded:opacity-100 hover:text-blue-light focus-visible:text-blue-light dark:hover:text-blue-dark dark:focus-visible:text-blue-dark focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-light dark:focus-visible:outline-blue-dark"
            >
              <Icon name="fa7-solid:chevron-down" class="size-2" />
            </button>
            <div
              id={`site-submenu-${index}`}
              hidden
              data-section-panel
              class="absolute top-10 left-1/2 z-10 flex w-full max-w-4xl -translate-x-1/2 flex-col gap-2 px-6 pt-10 transition-opacity duration-200 ease-in-out motion-reduce:transition-none"
            >
              <p class="text-sm text-slate-700 dark:text-slate-300">{link.label}</p>
              {link.links.map((sublink) => (
                <a
                  class="w-fit text-2xl font-bold text-black transition-colors duration-200 ease-in-out hover:text-blue-light focus-visible:text-blue-light dark:text-white dark:hover:text-blue-dark dark:focus-visible:text-blue-dark"
                  href={sublink.href}
                >
                  {sublink.label}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="grow"><!-- Spacer --></div>

      <div class="flex items-center">
        <div data-section-group data-desktop-other class="hidden h-12 items-center lg:flex">
          <button
            type="button"
            data-section-trigger
            aria-label={m.navOtherLinks()}
            aria-expanded="false"
            aria-controls="site-submenu-other"
            class="flex min-h-11 min-w-11 shrink-0 cursor-pointer items-center justify-center rounded transition-colors hover:text-blue-light focus-visible:text-blue-light dark:hover:text-blue-dark dark:focus-visible:text-blue-dark focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-light dark:focus-visible:outline-blue-dark"
          >
            <Icon name="fa7-solid:ellipsis" class="size-5" />
          </button>
          <div
            id="site-submenu-other"
            hidden
            data-section-panel
            class="absolute top-10 right-[max(1.5rem,calc((100%-56rem)/2+1.5rem))] z-10 flex flex-col items-end gap-2 pt-10"
          >
            <p class="text-sm text-slate-700 dark:text-slate-300">{rightLinks.label}</p>
            {rightLinks.links.map((link) => (
              <a
                class="text-2xl font-bold text-black transition-colors hover:text-blue-light focus-visible:text-blue-light dark:text-white dark:hover:text-blue-dark dark:focus-visible:text-blue-dark"
                href={link.href}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
        <a
          href="https://x.com/AR___212"
          aria-label={m.ariaXProfile()}
          class="flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded transition-colors hover:text-blue-light focus-visible:text-blue-light dark:hover:text-blue-dark dark:focus-visible:text-blue-dark focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-light dark:focus-visible:outline-blue-dark"
        >
          <Icon name="fa7-brands:x-twitter" class="size-5" />
        </a>
        <a
          href="https://github.com/Aaron-212"
          aria-label={m.ariaGithubProfile()}
          class="flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded transition-colors hover:text-blue-light focus-visible:text-blue-light dark:hover:text-blue-dark dark:focus-visible:text-blue-dark focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-light dark:focus-visible:outline-blue-dark"
        >
          <Icon name="fa7-brands:github" class="size-5" />
        </a>

        <details data-mobile-menu class="lg:hidden">
          <summary
            class="flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded transition-colors hover:text-blue-light focus-visible:text-blue-light dark:hover:text-blue-dark dark:focus-visible:text-blue-dark focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-blue-light dark:focus-visible:outline-blue-dark cursor-pointer list-none"
            aria-label={m.ariaToggleNavigation()}
          >
            <Icon name="fa7-solid:bars" class="size-5" />
          </summary>
          <div class="absolute top-12 left-1/2 flex w-full max-w-4xl -translate-x-1/2 flex-col gap-2 px-6 pt-8">
            {mobileLinks.map((link) => (
              <a
                class="text-2xl font-bold text-black transition-colors duration-200 ease-in-out hover:text-blue-light focus-visible:text-blue-light dark:text-white dark:hover:text-blue-dark dark:focus-visible:text-blue-dark"
                href={link.href}
              >
                {link.label}
              </a>
            ))}
          </div>
        </details>
      </div>
    </div>
  </nav>
</header>

<script>
  let cleanupNavigation: (() => void) | undefined;

  function setupNavigation() {
    cleanupNavigation?.();

    const navigation = document.querySelector<HTMLElement>("[data-navigation]");
    if (!navigation) return;

    const controller = new AbortController();
    const { signal } = controller;
    const desktop = window.matchMedia("(min-width: 64rem) and (not (any-pointer: coarse))");
    const hover = window.matchMedia("(hover: hover) and (pointer: fine)");
    const groups = Array.from(navigation.querySelectorAll<HTMLElement>("[data-section-group]"));
    let active: { button: HTMLButtonElement; panel: HTMLElement } | undefined;

    function closeMenu(restoreFocus = false) {
      if (!active) return;
      const { button, panel } = active;
      active = undefined;
      if (restoreFocus) button.focus();
      panel.hidden = true;
      button.setAttribute("aria-expanded", "false");
      navigation?.removeAttribute("data-expanded");
    }

    function openMenu(button: HTMLButtonElement, panel: HTMLElement) {
      if (!desktop.matches || active?.button === button) return;
      // A pointer must not hide a different submenu while keyboard focus is inside it.
      if (active?.panel.contains(document.activeElement)) return;
      closeMenu();
      active = { button, panel };
      panel.hidden = false;
      button.setAttribute("aria-expanded", "true");
      navigation?.setAttribute("data-expanded", "");
    }

    for (const group of groups) {
      const button = group.querySelector<HTMLButtonElement>("[data-section-trigger]");
      const panel = group.querySelector<HTMLElement>("[data-section-panel]");
      if (!button || !panel) continue;

      button.addEventListener(
        "click",
        () => {
          if (active?.button === button) closeMenu();
          else openMenu(button, panel);
        },
        { signal }
      );

      group.addEventListener(
        "pointerenter",
        (event) => {
          if (hover.matches && event.pointerType === "mouse") openMenu(button, panel);
        },
        { signal }
      );
    }

    navigation.addEventListener(
      "pointerleave",
      () => {
        if (active?.button !== document.activeElement && !active?.panel.contains(document.activeElement)) closeMenu();
      },
      { signal }
    );

    document.addEventListener(
      "focusin",
      (event) => {
        if (active && event.target !== active.button && !active.panel.contains(event.target as Node)) closeMenu();
      },
      { signal }
    );

    document.addEventListener(
      "pointerdown",
      (event) => {
        if (!navigation.contains(event.target as Node)) closeMenu();
      },
      { signal }
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape" || !active) return;
        const restoreFocus = active.button === document.activeElement || active.panel.contains(document.activeElement);
        closeMenu(restoreFocus);
        event.preventDefault();
      },
      { signal }
    );

    desktop.addEventListener("change", () => closeMenu(active?.panel.contains(document.activeElement)), { signal });

    cleanupNavigation = () => {
      closeMenu();
      controller.abort();
      cleanupNavigation = undefined;
    };
  }

  setupNavigation();
  document.addEventListener("astro:page-load", setupNavigation);
  document.addEventListener("astro:before-swap", () => cleanupNavigation?.());
</script>

<style>
  [data-site-header]::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-color: transparent;
    backdrop-filter: none;
    transition:
      background-color 250ms ease-in-out,
      backdrop-filter 250ms ease-in-out;
    content: "";
  }

  [data-section-panel][hidden] {
    display: none;
  }

  [data-mobile-menu] summary::-webkit-details-marker {
    display: none;
  }

  @media (max-width: 63.999rem), (any-pointer: coarse) {
    [data-navigation]:has([data-mobile-menu][open]) {
      height: 75dvh;
      overflow-y: auto;
      backdrop-filter: none;
    }
  }

  @media (min-width: 64rem) {
    [data-navigation][data-expanded] {
      height: 20rem;
      backdrop-filter: none;
    }
  }

  [data-site-header]:has([data-navigation][data-expanded], [data-mobile-menu][open])::before {
    background-color: rgb(250 250 250 / 0.25);
    backdrop-filter: blur(24px);
  }

  @media (any-pointer: coarse) {
    [data-desktop-sections],
    [data-desktop-other] {
      display: none;
    }

    [data-mobile-menu] {
      display: block;
    }
  }

  @media (prefers-color-scheme: dark) {
    [data-site-header]:has([data-navigation][data-expanded], [data-mobile-menu][open])::before {
      background-color: rgb(23 23 23 / 0.25);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-site-header]::before {
      transition: none;
    }

    [data-section-trigger] {
      transition: none;
    }
  }
</style>
