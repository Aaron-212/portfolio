---
interface Props {
  label: string;
  href: string;
  variant?: "primary" | "secondary";
}

const { label, href, variant } = Astro.props;
---

<a
  class:list={["text-md rounded-full px-6 py-2 md:text-lg", {
    "bg-blue-light text-white dark:bg-blue-dark": variant === "primary",
    "border text-blue-light border-blue-light dark:border-blue-dark": variant === "secondary"
  }]}
  href={href}
>
  {label}
</a>
