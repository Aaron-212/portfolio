---
interface Props {
  lightSrc: string;
  darkSrc: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
}

const { lightSrc, darkSrc, alt, class: className, width, height } = Astro.props;
---

<picture class={className}>
  <img src={lightSrc} alt={alt} width={width} height={height} />
  <source media="(prefers-color-scheme: dark)" srcset={darkSrc} />
</picture>
