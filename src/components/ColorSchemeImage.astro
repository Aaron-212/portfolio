---
interface Props {
  lightSrc: string;
  darkSrc: string;
  alt: string;
  class?: string;
}

const { lightSrc, darkSrc, alt, class: className } = Astro.props;
---

<img src={lightSrc} alt={alt} class:list={["block dark:hidden", className]} />
<img src={darkSrc} alt={alt} class:list={["hidden dark:block", className]} />
