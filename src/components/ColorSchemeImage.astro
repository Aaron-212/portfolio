---
interface Props {
  lightSrc: string;
  darkSrc: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
}

const { lightSrc, darkSrc, alt, class: className, width, height } = Astro.props;
---

<img src={lightSrc} alt={alt} class:list={["block dark:hidden", className]} width={width} height={height} />
<img src={darkSrc} alt={alt} class:list={["hidden dark:block", className]} width={width} height={height} />
