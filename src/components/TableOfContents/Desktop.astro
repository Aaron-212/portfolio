---
import { m } from "@/paraglide/messages.js";
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

<nav
  aria-label={m.tocAriaLabel()}
  data-table-of-contents
  class="not-prose hidden rounded-lg border border-slate-200 p-5 dark:border-slate-800 lg:sticky lg:top-24 lg:block lg:max-h-[calc(100dvh-8rem)] lg:w-64 lg:flex-none lg:overflow-y-auto 2xl:w-74"
>
  <p class="mb-3 text-sm font-semibold uppercase tracking-wide">{m.tocOnThisPage()}</p>
  <div class="relative">
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-s-0 top-0 h-0 border-s-2 border-s-blue-light opacity-0 transition-[height,transform,opacity] duration-300 ease-out motion-reduce:transition-none dark:border-s-blue-dark"
      data-toc-indicator
    ></span>
    <ol class="border-s-2 border-s-black/20 text-sm dark:border-s-white/20">
      {headings.map(({ depth, slug, text }) => (
        <li
          class={`group py-1 text-black/60 transition-colors aria-[current=location]:text-blue-light hover:text-black dark:text-white/60 dark:aria-[current=location]:text-blue-dark dark:hover:text-white ${
            depth === 3 ? "ps-8" : "ps-4"
          }`}
          data-toc-item
        >
          <a
            class="block text-inherit transition-all group-aria-[current=location]:font-semibold line-clamp-2"
            href={`#${slug}`}
          >
            {text}
          </a>
        </li>
      ))}
    </ol>
  </div>
</nav>

<script>
  let cleanupCurrentPage: (() => void) | undefined;

  function setupCurrentPage() {
    cleanupCurrentPage?.();

    const tableOfContents = document.querySelector<HTMLElement>("[data-table-of-contents]");
    const indicator = tableOfContents?.querySelector<HTMLElement>("[data-toc-indicator]");
    const items = Array.from(tableOfContents?.querySelectorAll<HTMLElement>("[data-toc-item]") ?? []);
    const entries = items.flatMap((item) => {
      const link = item.querySelector<HTMLAnchorElement>("a[href^='#']");
      const id = link?.getAttribute("href")?.slice(1);
      const heading = id ? document.getElementById(id) : null;

      return heading ? [{ heading, item }] : [];
    });

    if (!tableOfContents || !indicator || entries.length === 0) {
      cleanupCurrentPage = undefined;
      return;
    }

    const activeIndicator = indicator;
    const scrollContainer = tableOfContents;
    const controller = new AbortController();
    let animationFrame: number | undefined;

    function updateCurrentHeading() {
      animationFrame = undefined;

      const readingLine = 112;
      let currentHeading = entries[0].heading;

      for (const entry of entries) {
        if (entry.heading.getBoundingClientRect().top > readingLine) break;
        currentHeading = entry.heading;
      }

      for (const entry of entries) {
        if (entry.heading === currentHeading) {
          entry.item.setAttribute("aria-current", "location");

          const isInitialPosition = !activeIndicator.hasAttribute("data-ready");
          if (isInitialPosition) activeIndicator.style.transition = "none";

          activeIndicator.style.height = `${entry.item.offsetHeight}px`;
          activeIndicator.style.transform = `translateY(${entry.item.offsetTop}px)`;

          if (isInitialPosition) {
            activeIndicator.getBoundingClientRect();
            activeIndicator.setAttribute("data-ready", "");
            activeIndicator.style.removeProperty("transition");
            activeIndicator.classList.remove("opacity-0");
          }

          if (scrollContainer.clientHeight > 0) {
            const containerBounds = scrollContainer.getBoundingClientRect();
            const itemBounds = entry.item.getBoundingClientRect();
            const padding = 16;
            const visibleTop = containerBounds.top + scrollContainer.clientTop + padding;
            const visibleBottom = visibleTop + scrollContainer.clientHeight - padding * 2;

            if (itemBounds.top < visibleTop) {
              scrollContainer.scrollTop += itemBounds.top - visibleTop;
            } else if (itemBounds.bottom > visibleBottom) {
              scrollContainer.scrollTop += itemBounds.bottom - visibleBottom;
            }
          }
        } else {
          entry.item.removeAttribute("aria-current");
        }
      }
    }

    function scheduleUpdate() {
      if (animationFrame !== undefined) return;
      animationFrame = requestAnimationFrame(updateCurrentHeading);
    }

    cleanupCurrentPage = () => {
      controller.abort();
      if (animationFrame !== undefined) cancelAnimationFrame(animationFrame);
      cleanupCurrentPage = undefined;
    };

    updateCurrentHeading();
    window.addEventListener("scroll", scheduleUpdate, { passive: true, signal: controller.signal });
    window.addEventListener("resize", scheduleUpdate, { signal: controller.signal });
  }

  setupCurrentPage();
  document.addEventListener("astro:page-load", setupCurrentPage);
  document.addEventListener("astro:before-swap", () => cleanupCurrentPage?.());
</script>
