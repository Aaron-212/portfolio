---
import { m } from "@/paraglide/messages.js";
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  lang: string;
}

const { headings, lang } = Astro.props;
---

<details class="not-prose rounded-lg border border-slate-200 p-5 dark:border-slate-800 lg:hidden">
  <summary class="cursor-pointer text-sm font-semibold uppercase tracking-wide">{m.tocOnThisPage()}</summary>
  <nav aria-label={m.tocAriaLabel()} class="mt-3">
    <ol lang={lang} class="space-y-2 border-l-2 border-black/20 text-sm dark:border-white/20">
      {headings.map(({ depth, slug, text }) => (
        <li
          class={`text-black/60 dark:text-white/60 hover:text-black dark:hover:text-white transition-colors ${depth === 3 ? "ps-8" : "ps-4"}`}
        >
          <a class="block text-inherit" href={`#${slug}`}>
            {text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</details>
