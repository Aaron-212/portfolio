---
import { m } from "@/paraglide/messages.js";
import { deLocalizeHref, getLocale, localizeHref } from "@/paraglide/runtime.js";
import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();
const currentLocale = getLocale();
const baseHref = deLocalizeHref(`${Astro.url.pathname}${Astro.url.search}`);
const localeOptions = [
  { locale: "en", label: "English" },
  { locale: "zh-cn", label: "简体中文" }
] as const;
const currentLocaleLabel = localeOptions.find(({ locale }) => locale === currentLocale)?.label ?? currentLocale;
---

<footer class="mt-16 flex min-h-32 flex-col items-center justify-center bg-slate-100 text-center text-slate-600 select-none dark:bg-slate-900 dark:text-slate-300">
  <div class="flex w-full max-w-4xl flex-row items-center justify-between gap-4 px-6">
    <div class="flex flex-col items-start gap-1">
      <p>Aaron212 © 2021-{year}</p>
      <p class="text-sm">
        {m.footerLicensePrefix()}
        <a href="https://creativecommons.org/licenses/by-sa/4.0/" class="hover:underline">
          {m.footerLicenseName()}
        </a>
      </p>
    </div>

    <details class="group relative">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-3 py-2 transition-colors hover:bg-slate-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-light dark:hover:bg-slate-800 dark:focus-visible:outline-blue-dark"
        aria-label={m.ariaSwitchLanguage()}
      >
        <span>{currentLocaleLabel}</span>
        <Icon name="fa7-solid:chevron-down" class="size-3 transition-transform group-open:rotate-180" />
      </summary>

      <ul class="absolute right-0 bottom-full mb-2 min-w-36 overflow-hidden rounded-xl border border-slate-200 bg-white p-1 text-left shadow-lg dark:border-slate-700 dark:bg-slate-950">
        {localeOptions.map(({ locale, label }) => (
          <li>
            <a
              href={localizeHref(baseHref, { locale })}
              lang={locale}
              aria-current={locale === currentLocale ? "page" : undefined}
              class:list={[
                "block rounded-lg px-3 py-2 transition-colors hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-blue-light dark:hover:bg-slate-800 dark:focus-visible:outline-blue-dark",
                locale === currentLocale && "font-medium text-black dark:text-white"
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</footer>
