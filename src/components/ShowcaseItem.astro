---
import AppIcon from "@/components/AppIcon.astro";
import ArrowButton from "@/components/ArrowButton.astro";
import BranchTag from "@/components/BranchTag.astro";

interface Action {
  label: string;
  href: string;
}

interface Icon {
  lightSrc: string;
  darkSrc: string;
  alt: string;
}

interface Tag {
  name: string;
  tone: "mint" | "purple";
}

interface Props {
  title: string;
  description: string;
  actions: Action[];
  icon?: Icon;
  tag?: Tag;
}

const { title, description, actions, icon, tag } = Astro.props;
---

<article class="flex flex-row gap-4 p-4 md:gap-12">
  {
    icon ? (
      <AppIcon
        lightSrc={icon.lightSrc}
        darkSrc={icon.darkSrc}
        alt={icon.alt}
        class="mb-6 size-16 md:size-24 lg:size-32"
        sizes="8rem"
      />
    ) : (
      <div class="mb-6 w-16 shrink-0 md:w-24 lg:w-32" aria-hidden="true" />
    )
  }

  <div class="flex flex-1 flex-col gap-2 md:gap-4">
    <div class="flex flex-row items-center gap-4">
      <h2 class="text-2xl font-medium md:text-4xl">{title}</h2>
      {tag && <BranchTag name={tag.name} tone={tag.tone} />}
    </div>

    <p class="text-md text-slate-700 dark:text-slate-300 md:text-lg">{description}</p>

    <div class="flex flex-col flex-wrap items-start">
      {actions.map((action) => <ArrowButton label={action.label} href={action.href} />)}
    </div>

    <hr class="mt-4 border-0.5" />
  </div>
</article>
