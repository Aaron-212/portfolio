---
interface Props {
  name: string;
  lightBgClass?: string;
  darkBgClass?: string;
}

const { name, lightBgClass, darkBgClass } = Astro.props;
---

<span
  class={`rounded-md px-2 py-0.5 text-xs font-bold uppercase tracking-wide text-white ${lightBgClass} dark:${darkBgClass}`}
>
  {name}
</span>
