---
interface Props {
  name: string;
  tone: "mint" | "purple";
}

const { name, tone } = Astro.props;
---

<span
  class:list={[
    "rounded-md px-2 py-0.5 text-xs font-bold uppercase tracking-wide text-white",
    {
      "bg-mint-light dark:bg-mint-dark": tone === "mint",
      "bg-purple-light dark:bg-purple-dark": tone === "purple"
    }
  ]}
>
  {name}
</span>
