---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <div class="flex min-h-[75dvh] w-full flex-col items-center justify-center gap-3 px-6 text-center">
    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
      <h1 class="text-4xl font-semibold tracking-tight lg:text-6xl">404</h1>
      <h1 class="text-4xl font-light tracking-tight lg:text-6xl">Not Found</h1>
    </div>
    <span class="text-slate-600 dark:text-slate-300">Check the URL?</span>
  </div>
</BaseLayout>
