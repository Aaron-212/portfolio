---
import AppIcon from "@/components/AppIcon.astro";
import BranchTag from "@/components/BranchTag.astro";
import HeroButton from "@/components/HeroButton.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="NBTPlus">
  <div class="mx-auto flex max-w-3xl flex-col items-center px-6 py-12 text-center lg:py-20">
    <AppIcon
      lightSrc="https://images-bucket.aaron212.com/portfolio/nbtplus/NBTPlus-macOS-Default-1024%401x.png"
      darkSrc="https://images-bucket.aaron212.com/portfolio/nbtplus/NBTPlus-macOS-Dark-1024%401x.png"
      alt="NBTPlus应用图标"
      class="mb-8 w-48 lg:w-56"
      sizes="(min-width: 64rem) 14rem, 12rem"
    />
    <div class="flex flex-wrap items-center justify-center gap-2">
      <h1 class="text-5xl font-medium lg:text-6xl">NBTPlus</h1>
      <BranchTag name="Dev" tone="purple" />
    </div>
    <p class="mt-5 text-xl font-light text-slate-700 dark:text-slate-300 lg:text-2xl">适用于macOS的简洁NBT编辑器。</p>
    <p class="mt-10 rounded-xl bg-slate-50 px-6 py-5 text-slate-700 dark:bg-slate-950 dark:text-slate-300">
      此项目页面仍在建设中，更多详情和截图即将推出。
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <!-- <HeroButton label="下载" href="#" variant="primary" /> -->
      <HeroButton label="在GitHub上查看" href="https://github.com/Aaron-212/NBTPlus" variant="secondary" />
    </div>
  </div>
</BaseLayout>
