---
import BranchTag from "@/components/BranchTag.astro";
import ColorSchemeImage from "@/components/ColorSchemeImage.astro";
import HeroButton from "@/components/HeroButton.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="mx-auto flex flex-col gap-4">
    <div class="relative flex h-[72dvh] min-h-128 w-full place-items-center justify-center bg-slate-50 px-4 dark:bg-slate-950">
      <div class="flex flex-col items-center gap-4">
        <ColorSchemeImage
          lightSrc="https://images-bucket.ar212.com/portfolio/mcsrvrs/McSrvrS-iOS-Default-1024%401x.png"
          darkSrc="https://images-bucket.ar212.com/portfolio/mcsrvrs/McSrvrS-iOS-Dark-1024%401x.png"
          alt="McSrvrS App Icon"
          class="h-auto w-48 lg:w-64"
        />
        <div class="flex flex-row items-center gap-2">
          <span class="relative text-5xl font-medium lg:text-6xl">McSrvrS</span>
          <BranchTag name="Alpha" lightBgClass="bg-mint-light" darkBgClass="bg-mint-dark" />
        </div>
        <span class="text-center text-lg font-light lg:text-2xl">Check your Minecraft Server's status on the go.</span>
        <div class="flex flex-row items-center gap-4">
          <HeroButton label="Learn More" href="/projects/mcsrvrs" variant="primary" />
          <HeroButton label="Check it on GitHub" href="https://github.com/Aaron-212/McSrvrS" variant="secondary" />
        </div>
      </div>
    </div>
    <div class="grid w-full grid-cols-1 gap-4 lg:grid-cols-2">
      <div class="relative flex h-[72dvh] min-h-128 place-items-center justify-center bg-slate-50 bg-linear-to-b dark:bg-slate-950">
        <div class="flex flex-col items-center gap-4">
          <ColorSchemeImage
            lightSrc="https://images-bucket.ar212.com/portfolio/fnpilot/FnPilot-macOS-Default-1024%401x.png"
            darkSrc="https://images-bucket.ar212.com/portfolio/fnpilot/FnPilot-macOS-Dark-1024%401x.png"
            alt="FnPilot App Icon"
            class="h-auto w-48 lg:w-64"
          />
          <div class="flex flex-row items-center gap-2">
            <span class="relative text-5xl font-medium lg:text-6xl">FnPilot</span>
            <BranchTag name="Alpha" lightBgClass="bg-mint-light" darkBgClass="bg-mint-dark" />
          </div>
          <span class="text-center text-lg font-light lg:text-2xl">Change fn key settings based on frontmost window.
          </span>
          <div class="flex flex-row items-center gap-4">
            <HeroButton label="Learn More" href="/projects/fnpilot" variant="primary" />
            <HeroButton label="Check it on GitHub" href="https://github.com/Aaron-212/FnPilot" variant="secondary" />
          </div>
        </div>
      </div>
      <div class="relative flex h-[72dvh] min-h-128 place-items-center justify-center bg-slate-50 bg-linear-to-b to-75% dark:bg-slate-950">
        <div class="flex flex-col items-center gap-4">
          <ColorSchemeImage
            lightSrc="https://images-bucket.ar212.com/portfolio/nbtplus/NBTPlus-macOS-Default-1024%401x.png"
            darkSrc="https://images-bucket.ar212.com/portfolio/nbtplus/NBTPlus-macOS-Dark-1024%401x.png"
            alt="NBTPlus App Icon"
            class="h-auto w-48 lg:w-64"
          />
          <div class="flex flex-row items-center gap-2">
            <span class="relative text-5xl font-medium lg:text-6xl">NBTPlus</span>
            <BranchTag name="Dev" lightBgClass="bg-purple-light" darkBgClass="bg-purple-dark" />
          </div>
          <span class="text-center text-lg font-light lg:text-2xl">Simple NBT editor on macOS.</span>
          <div class="flex flex-row items-center gap-4">
            <HeroButton label="Learn More" href="/projects/nbtplus" variant="primary" />
            <HeroButton label="Check it on GitHub" href="https://github.com/Aaron-212/NBTPlus" variant="secondary" />
          </div>
        </div>
      </div>
    </div>
    <div class="relative flex h-[72dvh] min-h-128 w-full place-items-center justify-center bg-slate-200 dark:bg-slate-800">
      <div>Under Construction...</div>
    </div>
  </div>
</BaseLayout>
