---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="mx-auto flex flex-col gap-4">
    <div
      class="relative flex h-[72dvh] min-h-128 w-full place-items-center justify-center bg-neutral-100 px-4 dark:bg-neutral-900"
    >
      <div class="flex flex-col items-center gap-4">
        <img
          src="https://images-bucket.ar212.com/portfolio/mcsrvrs/McSrvrS-iOS-Default-1024%401x.png"
          alt="McSrvrS App Icon"
          class="block max-h-64 w-auto dark:hidden"
        />
        <img
          src="https://images-bucket.ar212.com/portfolio/mcsrvrs/McSrvrS-iOS-Dark-1024%401x.png"
          alt="McSrvrS App Icon"
          class="hidden max-h-64 w-auto dark:block"
        />
        <div class="flex flex-row items-center gap-2">
          <span class="relative text-5xl font-medium lg:text-6xl">McSrvrS</span>
          <span
            class="text-md rounded-full border border-mint-light px-2 py-0.5 text-mint-light dark:border-mint-dark dark:text-mint-dark"
          >
            Alpha
          </span>
        </div>
        <span class="text-center text-lg font-light lg:text-2xl">Check your Minecraft Server's status on the go.</span>
        <div class="flex flex-row items-center gap-4">
          <a
            class="text-md rounded-full bg-blue-light px-6 py-2 text-white md:text-lg dark:bg-blue-dark"
            href="/projects/mcsrvrs"
          >
            Learn More
          </a>
          <a
            class="text-md rounded-full border border-blue-light px-6 py-2 text-blue-light md:text-lg dark:border-blue-dark dark:text-blue-dark"
            href="https://github.com/Aaron-212/McSrvrS"
          >
            Check it on GitHub
          </a>
        </div>
      </div>
    </div>
    <div
      class="relative flex h-[72dvh] min-h-128 w-full place-items-center justify-center bg-linear-to-b from-neutral-100 to-blue-light to-75% dark:from-neutral-900 dark:to-blue-dark"
    >
      <div class="flex flex-col items-center gap-2">
        <span class="relative text-6xl font-medium">Aaron212</span>
      </div>
    </div>
    <div
      class="relative flex h-[72dvh] min-h-128 w-full place-items-center justify-center bg-neutral-200 dark:bg-neutral-900"
    >
      <div>Under Construcion...</div>
    </div>
  </div>
</BaseLayout>
