---
import ColorSchemeImage from "@/components/ColorSchemeImage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="mx-auto flex flex-col gap-4">
    <div class="relative flex h-[72dvh] min-h-128 w-full place-items-center justify-center bg-neutral-100 px-4 dark:bg-neutral-900">
      <div class="flex flex-col items-center gap-4">
        <ColorSchemeImage
          lightSrc="https://images-bucket.ar212.com/portfolio/mcsrvrs/McSrvrS-iOS-Default-1024%401x.png"
          darkSrc="https://images-bucket.ar212.com/portfolio/mcsrvrs/McSrvrS-iOS-Dark-1024%401x.png"
          alt="McSrvrS App Icon"
          class="h-auto w-48 lg:w-64"
        />
        <div class="flex flex-row items-center gap-2">
          <span class="relative text-5xl font-medium lg:text-6xl">McSrvrS</span>
          <span
            class="rounded-lg bg-mint-light px-2 py-0.5 text-sm font-bold text-white uppercase dark:bg-mint-dark dark:text-black"
          >
            Alpha
          </span>
        </div>
        <span class="text-center text-lg font-light lg:text-2xl">Check your Minecraft Server's status on the go.</span>
        <div class="flex flex-row items-center gap-4">
          <a
            class="text-md rounded-full bg-blue-light px-6 py-2 text-white md:text-lg dark:bg-blue-dark"
            href="/projects/mcsrvrs"
          >
            Learn More
          </a>
          <a
            class="text-md rounded-full border border-blue-light px-6 py-2 text-blue-light md:text-lg dark:border-blue-dark dark:text-blue-dark"
            href="https://github.com/Aaron-212/McSrvrS"
          >
            Check it on GitHub
          </a>
        </div>
      </div>
    </div>
    <div class="grid w-full grid-cols-1 gap-4 lg:grid-cols-2">
      <div class="relative flex h-[72dvh] min-h-128 place-items-center justify-center bg-neutral-100 bg-linear-to-b dark:bg-neutral-900">
        <div class="flex flex-col items-center gap-4">
          <ColorSchemeImage
            lightSrc="https://images-bucket.ar212.com/portfolio/fnpilot/FnPilot-macOS-Default-1024%401x.png"
            darkSrc="https://images-bucket.ar212.com/portfolio/fnpilot/FnPilot-macOS-Dark-1024%401x.png"
            alt="FnPilot App Icon"
            class="h-auto w-48 lg:w-64"
          />
          <div class="flex flex-row items-center gap-2">
            <span class="relative text-5xl font-medium lg:text-6xl">FnPilot</span>
            <span
              class="rounded-lg bg-mint-light px-2 py-0.5 text-sm font-bold text-white uppercase dark:bg-mint-dark dark:text-black"
            >
              Alpha
            </span>
          </div>
          <span class="text-center text-lg font-light lg:text-2xl">Change fn key settings based on frontmost window.
          </span>
          <div class="flex flex-row items-center gap-4">
            <a
              class="text-md rounded-full bg-blue-light px-6 py-2 text-white md:text-lg dark:bg-blue-dark"
              href="/projects/fnpilot"
            >
              Learn More
            </a>
            <a
              class="text-md rounded-full border border-blue-light px-6 py-2 text-blue-light md:text-lg dark:border-blue-dark dark:text-blue-dark"
              href="https://github.com/Aaron-212/FnPilot"
            >
              Check it on GitHub
            </a>
          </div>
        </div>
      </div>
      <div class="relative flex h-[72dvh] min-h-128 place-items-center justify-center bg-neutral-100 bg-linear-to-b to-75% dark:bg-neutral-900">
        <div class="flex flex-col items-center gap-4">
          <ColorSchemeImage
            lightSrc="https://images-bucket.ar212.com/portfolio/nbtplus/NBTPlus-macOS-Default-1024%401x.png"
            darkSrc="https://images-bucket.ar212.com/portfolio/nbtplus/NBTPlus-macOS-Dark-1024%401x.png"
            alt="NBTPlus App Icon"
            class="h-auto w-48 lg:w-64"
          />
          <div class="flex flex-row items-center gap-2">
            <span class="relative text-5xl font-medium lg:text-6xl">NBTPlus</span>
            <span
              class="rounded-lg bg-purple-light px-2 py-0.5 text-sm font-bold text-white uppercase dark:text-black dark:bg-purple-dark"
            >
              Dev
            </span>
          </div>
          <span class="text-center text-lg font-light lg:text-2xl">Simple NBT editor for Minecraft.</span>
          <div class="flex flex-row items-center gap-4">
            <a
              class="text-md rounded-full bg-blue-light px-6 py-2 text-white md:text-lg dark:bg-blue-dark"
              href="/projects/nbtplus"
            >
              Learn More
            </a>
            <a
              class="text-md rounded-full border border-blue-light px-6 py-2 text-blue-light md:text-lg dark:border-blue-dark dark:text-blue-dark"
              href="https://github.com/Aaron-212/NBTPlus"
            >
              Check it on GitHub
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="relative flex h-[72dvh] min-h-128 w-full place-items-center justify-center bg-neutral-200 dark:bg-neutral-900">
      <div>Under Construction...</div>
    </div>
  </div>
</BaseLayout>
