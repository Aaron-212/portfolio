---
import BranchTag from "@/components/BranchTag.astro";
import HeroButton from "@/components/HeroButton.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { m } from "@/paraglide/messages.js";
---

<BaseLayout title="McSrvrS">
  <div class="mx-auto mb-12 flex max-w-4xl flex-col items-center gap-5 px-6 text-center">
    <img
      src="https://images-bucket.aaron212.com/portfolio/mcsrvrs/McSrvrS%20Hero%20Showcase.png"
      alt={m.heroShowcaseAlt({ name: "McSrvrS" })}
      class="w-full rounded-xl"
      width={2560}
      height={1322}
    />
    <div class="flex flex-wrap items-center justify-center gap-2">
      <span class="text-5xl font-medium lg:text-6xl">McSrvrS</span>
      <BranchTag name="Alpha" tone="mint" />
    </div>
    <p class="max-w-2xl text-lg font-light text-slate-700 dark:text-slate-300 lg:text-xl">
      {m.mcsrvrsDescription()}
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <!-- <HeroButton label={m.downloadMacos()} href="https://github.com/Aaron-212/McSrvrS/releases" variant="primary" /> -->
      <HeroButton label={m.checkOnGithub()} href="https://github.com/Aaron-212/McSrvrS" variant="secondary" />
    </div>
  </div>
  <div class="prose mx-auto flex max-w-4xl flex-col px-6 select-auto dark:prose-invert lg:prose-lg">
    <div>
      <p>{m.mcsrvrsOverview()}</p>
    </div>
    <h2>{m.features()}</h2>
    <ul>
      <li>{m.mcsrvrsFeatureMonitor()}</li>
      <li>{m.mcsrvrsFeatureStatus()}</li>
      <li>{m.mcsrvrsFeatureCharts()}</li>
      <li>{m.mcsrvrsFeatureManage()}</li>
      <li>{m.mcsrvrsFeatureDns()}</li>
      <li>{m.mcsrvrsFeatureAddresses()}</li>
      <li>{m.mcsrvrsFeatureRefresh()}</li>
      <li>{m.mcsrvrsFeatureWidgets()}</li>
      <li>{m.mcsrvrsFeatureWidgetLink()}</li>
      <li>{m.mcsrvrsFeatureMenuBar()}</li>
    </ul>
    <h2>{m.roadmap()}</h2>
    <p>{m.comingSoon()}</p>
    <h2>{m.builtWith()}</h2>
    <ul>
      <li>SwiftUI</li>
      <li>SwiftData</li>
      <li>Swift Charts</li>
      <li>{m.widgetKitAndAppIntents()}</li>
      <li>BackgroundTasks</li>
      <li><a href="https://github.com/apple/swift-async-dns-resolver">swift-async-dns-resolver</a></li>
    </ul>
    <h2>{m.contributing()}</h2>
    <p>{m.contributingDescription()}</p>
  </div>
</BaseLayout>
