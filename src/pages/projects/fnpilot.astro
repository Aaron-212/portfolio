---
import AppIcon from "@/components/AppIcon.astro";
import BranchTag from "@/components/BranchTag.astro";
import HeroButton from "@/components/HeroButton.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="FnPilot">
  <div class="mx-auto flex max-w-3xl flex-col items-center px-6 py-12 text-center lg:py-20">
    <AppIcon
      lightSrc="https://images-bucket.aaron212.com/portfolio/fnpilot/FnPilot-macOS-Default-1024%401x.png"
      darkSrc="https://images-bucket.aaron212.com/portfolio/fnpilot/FnPilot-macOS-Dark-1024%401x.png"
      alt="FnPilot app icon"
      class="mb-8 w-48 lg:w-56"
      sizes="(min-width: 64rem) 14rem, 12rem"
    />
    <div class="flex flex-wrap items-center justify-center gap-2">
      <h1 class="text-5xl font-medium lg:text-6xl">FnPilot</h1>
      <BranchTag name="Alpha" tone="mint" />
    </div>
    <p class="mt-5 text-xl font-light text-slate-700 dark:text-slate-300 lg:text-2xl">
      Change fn key settings based on the frontmost window.
    </p>
    <p class="mt-10 rounded-xl bg-slate-50 px-6 py-5 text-slate-700 dark:bg-slate-950 dark:text-slate-300">
      This project page is still under construction. More details and screenshots will be added soon.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <!-- <HeroButton label="Download" href="#" variant="primary" /> -->
      <HeroButton label="Check it on GitHub" href="https://github.com/Aaron-212/FnPilot" variant="secondary" />
    </div>
  </div>
</BaseLayout>
