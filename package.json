{
  "name": "portfolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy:workers": "astro build && wrangler deploy",
    "preview": "astro preview",
    "check": "astro check",
    "check:watch": "astro check --watch",
    "format": "oxfmt --ignore-path=.gitignore . && prettier --write \"**/*.astro\"",
    "format:astro": "prettier --write \"**/*.astro\"",
    "format:oxfmt": "oxfmt --ignore-path=.gitignore .",
    "lint": "oxfmt --check --ignore-path=.gitignore . && prettier --check \"**/*.astro\" && oxlint .",
    "lint:format": "oxfmt --check --ignore-path=.gitignore . && prettier --check \"**/*.astro\""
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/fa7-brands": "^1.2.4",
    "@iconify-json/fa7-solid": "^1.2.5",
    "@inlang/paraglide-js": "^2.25.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "astro-mermaid": "^2.1.0",
    "mermaid": "^11.17.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.0",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "astro-icon": "^1.2.0"
  }
